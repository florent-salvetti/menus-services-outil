# ============================================================================
# Générateur de documents Les Menus Services — .gitignore
# ============================================================================

# --- Données sensibles / personnelles (NE JAMAIS committer) ------------------
# Dossiers bénéficiaires générés (données perso + bancaires)
dossiers/
# Base locale SQLite + état de licence
donnees/
# Vrai fichier de config : clé de licence + constantes agence (secret)
config.json
# Fichiers de licence : le vrai licences.json vit dans un dépôt SÉPARÉ que le
# prestataire contrôle ; aucun ne doit être versionné ici (dev compris).
licences*.json
# RIB scannés éventuellement déposés à la racine
*.rib
rib_*.png
rib_*.jpg
rib_*.jpeg

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Artefacts régénérables --------------------------------------------------
# Copies-templates balisées, reconstruites depuis les originaux par
# construire_template(). Seuls les modèles d'origine font foi.
modeles/_template_*.docx

# --- Binaires embarqués (artefacts de livraison, pas source) -----------------
# Placés dans le dossier de l'app et livrés avec, mais non versionnés
# (volumineux, binaires, propres à la plateforme).
# OCR : tesseract.exe + tessdata/
tesseract/
# Impression PDF : LibreOffice Portable (program/soffice.exe)
libreoffice/

# --- Packaging PyInstaller ---------------------------------------------------
build/
dist/
*.spec
# ...sauf notre .spec écrit à la main (recette de build = source à versionner).
!MenusServices.spec

# --- Fichiers temporaires LibreOffice / Office -------------------------------
# Verrous LibreOffice
.~lock.*#
# Fichiers temporaires Word/Office
~$*.doc
~$*.docx
~$*.xlsx
*.tmp

# --- OS / éditeurs -----------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
